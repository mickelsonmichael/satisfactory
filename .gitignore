node_modules/
dist/
.env
.env.local

# Map tiles are fetched during CI build (run `node scripts/download-tiles.mjs` for local dev)
public/tiles/

# Icons are fetched during CI build (run the matching download script for local dev)
public/icons/resources/
# Match the directory's *contents* (not the dir itself) so the two committed icons
# below can be re-included — git can't un-ignore a file under an excluded directory.
public/icons/collectibles/*
# ...except these two, which have no clean auto-fetchable source (the Boom Box tape
# icon and the cropped B-374 helmet render), so they are committed directly.
!public/icons/collectibles/Boom_Box.png
!public/icons/collectibles/B-374_Helmet.png

# TypeScript build info
node_modules/.tmp/

key     # Local keys, stored for convenience
key.pub # Local keys, stored for convenience
